generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                @id @default(uuid()) @db.Uuid
  email                  String                @unique
  password               String
  name                   String?
  last_name              String?
  created_at             DateTime              @default(now())
  updated_at             DateTime              @updatedAt
  date_of_birth          DateTime?             @map("date_of_birth")
  gender                 String?
  goal_id                Int?
  height                 Float?
  weight                 Float?
  has_disability         Boolean?              @default(false) @map("has_disability")
  disability_description String?               @map("disability_description")
  bmi                    Float?
  level                  userLevel             @default(beginner)
  token_version          Int                   @default(0)
  role                   UserGlobalRole        @default(USER)
  gym_classes_instructor gym_classes[]         @relation("gym_classes_instructor")
  assigned_memberships   gym_memberships[]     @relation("gym_memberships_assigned_byTousers")
  trained_memberships    gym_memberships[]     @relation("gym_memberships_trainer_idTousers")
  gym_membership         gym_memberships?      @relation("gym_memberships_user_idTousers")
  password_reset_codes   PasswordResetCode[]
  password_setup_tokens  PasswordSetupToken[]
  refresh_tokens         RefreshToken[]
  routine_completions    routine_completions[]
  user_training_days     user_training_days[]
  goals                  goals?                @relation(fields: [goal_id], references: [id], onUpdate: NoAction, map: "fk_users_goal")

  @@index([goal_id], map: "idx_users_goal_id")
  @@map("users")
}

model PasswordResetCode {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  code       String
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_password_reset_code_user_id")
  @@map("password_reset_codes")
}

model PasswordSetupToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token      String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_password_setup_token_user_id")
  @@index([token], map: "idx_password_setup_token_token")
  @@map("password_setup_tokens")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  token      String   @unique
  user_id    String   @db.Uuid
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token], map: "idx_refresh_token_token")
  @@index([user_id], map: "idx_refresh_token_user_id")
  @@index([expires_at], map: "idx_refresh_token_expires_at")
  @@map("refresh_tokens")
}

model MuscleGroup {
  id               String           @id @default(uuid()) @db.Uuid
  name             String           @unique
  description      String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  name_en          String?
  exercise_muscles ExerciseMuscle[]
  exercises        Exercise[]

  @@map("muscle_groups")
}

model Exercise {
  id                        String                      @id @default(uuid()) @db.Uuid
  name                      String
  description               String?
  muscle_group_id           String                      @db.Uuid
  created_at                DateTime                    @default(now())
  updated_at                DateTime                    @updatedAt
  link_img                  String?
  starting_position         String?
  execution                 String?
  tips                      String[]
  equipment                 String[]
  difficulty                String?                     @db.VarChar(20)
  exercise_muscles          ExerciseMuscle[]
  muscle_group              MuscleGroup                 @relation(fields: [muscle_group_id], references: [id], onDelete: Cascade)
  popular_routine_exercises popular_routine_exercises[]

  @@map("exercises")
}

model ExerciseMuscle {
  id              String      @id @default(uuid()) @db.Uuid
  exercise_id     String      @db.Uuid
  muscle_group_id String      @db.Uuid
  is_primary      Boolean     @default(false)
  created_at      DateTime    @default(now())
  exercise        Exercise    @relation(fields: [exercise_id], references: [id], onDelete: Cascade)
  muscle_group    MuscleGroup @relation(fields: [muscle_group_id], references: [id], onDelete: Cascade)

  @@unique([exercise_id, muscle_group_id])
  @@map("exercise_muscles")
}

model days_of_week {
  id                 Int                  @id
  name_en            String               @db.VarChar(10)
  name_es            String               @db.VarChar(10)
  short_name         String               @db.VarChar(3)
  routine_days       routine_days[]
  user_training_days user_training_days[]
}

model user_training_days {
  user_id String       @db.Uuid
  day_id  Int
  day     days_of_week @relation(fields: [day_id], references: [id])
  user    User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, day_id])
  @@map("user_training_days")
}

model routine_days {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routine_id   String?       @db.Uuid
  day_id       Int?
  created_at   DateTime?     @default(now()) @db.Timestamp(6)
  days_of_week days_of_week? @relation(fields: [day_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  routines     routines?     @relation(fields: [routine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([routine_id, day_id])
}

model routine_exercises {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routine_id            String?                 @db.Uuid
  exercise_id           String?                 @db.Uuid
  order_position        Int
  sets                  Int?
  reps                  Int?
  weight                Decimal?                @db.Decimal(10, 2)
  rest_time             Int?
  notes                 String?
  created_at            DateTime?               @default(now()) @db.Timestamp(6)
  routine_exercise_sets routine_exercise_sets[]
  routines              routines?               @relation(fields: [routine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model routine_exercise_sets {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routine_exercise_id String            @db.Uuid
  set_number          Int
  weight              Decimal?          @db.Decimal(10, 2)
  reps                Int?
  rest_time           Int?
  created_at          DateTime?         @default(now()) @db.Timestamp(6)
  routine_exercises   routine_exercises @relation(fields: [routine_exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([routine_exercise_id, set_number])
  @@index([routine_exercise_id])
}

model routines {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @db.VarChar(255)
  description         String?
  user_id             String                @db.Uuid
  estimated_duration  Int?
  level               String?               @db.VarChar(50)
  goal                String?               @db.VarChar(50)
  is_active           Boolean?              @default(true)
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @default(now()) @db.Timestamp(6)
  completed_at        DateTime?             @db.Timestamp(6)
  is_completed        Boolean?              @default(false)
  deleted_at          DateTime?             @db.Timestamp(6)
  routine_completions routine_completions[]
  routine_days        routine_days[]
  routine_exercises   routine_exercises[]
}

model goals {
  id          Int     @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  description String?
  users       User[]
}

model routine_completions {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  routine_id   String   @db.Uuid
  completed_at DateTime @default(now()) @db.Timestamp(6)
  day_of_week  Int
  created_at   DateTime @default(now()) @db.Timestamp(6)
  routine      routines @relation(fields: [routine_id], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_routine_completions_user_id")
  @@index([routine_id], map: "idx_routine_completions_routine_id")
  @@index([completed_at], map: "idx_routine_completions_completed_at")
  @@map("routine_completions")
}

model popular_routine_exercises {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  popular_routine_id String           @db.Uuid
  exercise_id        String           @db.Uuid
  order_position     Int
  sets               Int?
  reps               Int?
  weight             Decimal?         @db.Decimal(10, 2)
  rest_time          Int?
  notes              String?
  created_at         DateTime?        @default(now()) @db.Timestamp(6)
  exercises          Exercise         @relation(fields: [exercise_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  popular_routines   popular_routines @relation(fields: [popular_routine_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([exercise_id], map: "idx_popular_routine_exercises_exercise_id")
  @@index([popular_routine_id], map: "idx_popular_routine_exercises_routine_id")
}

model popular_routines {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String                      @db.VarChar(255)
  description               String?
  level                     userLevel
  estimated_duration        Int?
  created_at                DateTime?                   @default(now()) @db.Timestamp(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamp(6)
  popular_routine_exercises popular_routine_exercises[]
}

model gym_invitations {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String            @db.VarChar(255)
  gym_id     String            @db.Uuid
  created_at DateTime?         @default(now()) @db.Timestamp(6)
  updated_at DateTime?         @updatedAt @db.Timestamp(6)
  status     invitation_status @default(PENDING)
  gyms       gyms              @relation(fields: [gym_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([email, gym_id], map: "unique_invitation_per_gym")
  @@index([email, status])
}

model gym_memberships {
  id                                       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gym_id                                   String            @db.Uuid
  user_id                                  String            @unique(map: "unique_user_membership") @db.Uuid
  status                                   membership_status @default(ACTIVE)
  plan                                     String?           @db.VarChar(100)
  start_date                               DateTime          @default(dbgenerated("CURRENT_DATE")) @db.Date
  end_date                                 DateTime?         @db.Date
  assigned_by                              String?           @db.Uuid
  notes                                    String?
  created_at                               DateTime?         @default(now()) @db.Timestamp(6)
  updated_at                               DateTime?         @default(now()) @db.Timestamp(6)
  active_role                              GymRole           @default(MEMBER)
  gym_roles                                GymRole[]
  trainer_id                               String?           @db.Uuid
  users_gym_memberships_assigned_byTousers User?             @relation("gym_memberships_assigned_byTousers", fields: [assigned_by], references: [id], onUpdate: NoAction)
  gyms                                     gyms              @relation(fields: [gym_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_gym_memberships_trainer_idTousers  User?             @relation("gym_memberships_trainer_idTousers", fields: [trainer_id], references: [id], onUpdate: NoAction)
  users_gym_memberships_user_idTousers     User              @relation("gym_memberships_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model gyms {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String            @db.VarChar(255)
  slug            String            @unique @db.VarChar(255)
  description     String?
  address         String?
  city            String?           @db.VarChar(100)
  country         String?           @default("CO") @db.VarChar(10)
  logo_url        String?
  cover_image_url String?
  phone           String?           @db.VarChar(20)
  email           String?           @db.VarChar(255)
  is_active       Boolean?          @default(true)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  gym_classes     gym_classes[]
  gym_invitations gym_invitations[]
  gym_memberships gym_memberships[]
}

model gym_classes {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gym_id           String    @db.Uuid
  instructor_id    String    @db.Uuid
  activity         String    @db.VarChar(100)
  name             String    @db.VarChar(255)
  class_date       DateTime  @db.Date
  start_minutes    Int
  duration_minutes Int
  room             String    @db.VarChar(100)
  capacity         Int
  enrolled         Int       @default(0)
  color            String    @db.VarChar(20)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @updatedAt @db.Timestamp(6)
  gyms             gyms      @relation(fields: [gym_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  instructor       User      @relation("gym_classes_instructor", fields: [instructor_id], references: [id], onUpdate: NoAction)

  @@index([gym_id, class_date], map: "idx_gym_classes_gym_date")
  @@index([instructor_id], map: "idx_gym_classes_instructor")
}

enum userLevel {
  beginner
  intermediate
  advanced
}

enum membership_status {
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum invitation_status {
  PENDING
  ACCEPTED
  REJECTED
}

enum UserGlobalRole {
  USER
  ADMIN
  SUPERADMIN
  MEMBER
}

enum GymRole {
  GYM_ADMIN
  TRAINER
  MEMBER
}
